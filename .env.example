# 宿主机端口只绑本机回环，避免无意暴露到网络。
# 需要局域网访问时把 ARW_BIND 改成 0.0.0.0。
# 容器内始终监听 0.0.0.0，因此必须设置访问口令；即使只在本机浏览器打开也需要。
ARW_BIND=127.0.0.1
ARW_PORT=8765
# 首次启动且 ./data 还没有库时必须填写，否则 scripts/docker-up.sh 会拒绝启动。
APPLE_REFURB_WATCH_ACCESS_TOKEN=
# 宿主机用户 uid/gid。群晖等 NAS 上往往不是 1000，改成 `id -u` / `id -g`。
PUID=1000
PGID=1000
